<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Resources AI Chatbot Plugin">
    <f:entry title="FastAPI backend URL" field="backendUrl">
      <f:textbox />
    </f:entry>
    <f:entry field="autoStartBackend">
      <f:checkbox title="Start the backend automatically" />
    </f:entry>
    <f:entry title="Backend directory" field="backendDirectory"
             description="Path to the chatbot-core folder on this Jenkins machine. Run make setup-backend there first.">
      <f:textbox />
    </f:entry>
  </f:section>
</j:jelly>
